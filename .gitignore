# ==============================================================================
# Comprehensive .gitignore for SiddhiVinayak Enterprise - Bill Generator
# Stack: Next.js (TypeScript, Tailwind CSS) + FastAPI (Python, MongoDB)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environment Folders
myenv/
backend/myenv/
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging & Distribution
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
*.manifest
*.spec

# Testing, Linting & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
coverage.xml
nosetests.xml

# ------------------------------------------------------------------------------
# 2. Node.js, Next.js & Frontend Tooling
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
frontend/node_modules/

# Next.js Build Outputs & Cache
.next/
**/.next/
frontend/.next/
out/
**/out/
frontend/out/
build/
frontend/build/

# TypeScript Build Info Cache
*.tsbuildinfo
next-env.d.ts

# Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secret Keys
# ------------------------------------------------------------------------------
.env
**/.env
.env*.local
**/.env*.local
.env.development.local
.env.test.local
.env.production.local

# Allow committing sample environment templates
!.env.example
!**/.env.example

# ------------------------------------------------------------------------------
# 4. User Uploads & Media Files
# ------------------------------------------------------------------------------
uploads/*
backend/uploads/*

# Preserve default sample vehicle demo images and .gitkeep
!uploads/.gitkeep
!uploads/auto_rickshaw_*
!backend/uploads/.gitkeep
!backend/uploads/auto_rickshaw_*

# ------------------------------------------------------------------------------
# 5. Operating System Junk Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 6. IDEs & Code Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ------------------------------------------------------------------------------
# 7. Temporary, Scratch & Log Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
Pages.txt
